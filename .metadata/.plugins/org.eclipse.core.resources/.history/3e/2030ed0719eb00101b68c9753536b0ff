


public class Nicolas {
	
	int i = 4;
	int j = 5;
	static int k;
	
	public static void main(String a[]) {
		
		Nicolas nicolas1 = new Nicolas();
		Nicolas nicolas2 = new Nicolas();
		
		nicolas1.add();       nicolas2.add();
		
		System.out.println(nicolas1.i);
		System.out.println(nicolas1.j);
		System.out.println(nicolas1.k);
		
		System.out.println(nicolas2.i);
		System.out.println(nicolas2.j);
		System.out.println(nicolas2.k);

	}
	
	void add() {
		
		k = i + j + k;
	}	
}


