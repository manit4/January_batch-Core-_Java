
class A implements Runnable {
	
	public void run() {
		for(int i = 0; i < 20; i++) {
			System.out.println(Thread.currentThread().getName());
		}
	}
}

public class MultiThread {

	public static void main(String[] args) {
		
		A runnable = new A();
		Thread thread =  new Thread(runnable);
		
		thread.start();
	}
}



