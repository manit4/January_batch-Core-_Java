package com.ftcampus.first;//package statement must be the first statement of the file...


class Human {
	
	private int iq = 4;
	
	public void study() {
		iq++;
	}
	
	public int getIq() {
		return iq;
	}
}

public class First {
	
	public static void main(String[] args) {
		
		Human manit =  new Human();
		manit.study();
		System.out.println(manit.getIq());
	}
}







