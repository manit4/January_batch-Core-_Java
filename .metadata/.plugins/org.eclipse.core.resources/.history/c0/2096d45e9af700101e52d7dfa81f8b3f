import java.util.function.Consumer;
import java.util.function.Predicate;
import java.util.function.Supplier;

class Employee {

	String name;
	int workX;
	int salary;

	public Employee(String name, int workX, int salary) {
		this.name = name;
		this.workX = workX;
		this.salary = salary;
	}
}

public class Java8 {

	public static void main(String[] args) {
		
		Employee employee = new Employee("Lin", 3, 12000);

		Supplier<Integer> supplier = () -> {
			
			if(employee.workX > 5) {
				return employee.salary * 2;
			}
			else {
				return null;
			}
		};
		
		System.out.println("The Bonus is "+supplier.get());

		
	}
}


